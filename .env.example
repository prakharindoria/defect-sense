# FORGE environment. Copy to .env and fill in.
# Secrets come from the environment ONLY -- never from a config file, never
# committed. config/*.yaml holds ${VAR} references, not values.

# ---------------------------------------------------------------------------
# Runtime profile
# ---------------------------------------------------------------------------
# local  -> SQLite + local filesystem + embedded Chroma + fakeredis. No Docker.
# docker -> Postgres + Redis + Chroma server + MinIO via infra/docker-compose.yml
PROFILE=local
FORGE_ENV=development
LOG_LEVEL=INFO

# Pins RNG seeds, fixes the event sequence, serves LLM responses from the
# pre-warmed cache, disables fault injection. Set true on stage.
DEMO_MODE=false

# ---------------------------------------------------------------------------
# Security. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# ---------------------------------------------------------------------------
JWT_SECRET=
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# LLM providers. Leave a block blank to skip that provider in the tier chain.
# Resolution order per tier is defined in config/models.yaml.
# ---------------------------------------------------------------------------
# --- TCS GenAI Lab (primary) ------------------------------------------------
# Only TCS_API_KEY is required; everything else has a working default.
# The key is issued at the event. NEVER commit it.
TCS_API_KEY=sk-2goK0FU8NTL-pD2uNF2dAw
TCS_BASE_URL=https://genailab.tcs.in
# gpt-4o for reasoning: TCS's own guidance puts it on robust JSON parsing and
# central application logic, which is exactly what the Adjudicator needs since
# it must emit a strict schema. DeepSeek-R1 reasons better but emits <think>
# preamble and is slow; swap it in here if you want to compare.
TCS_REASONING_MODEL=azure/genailab-maas-gpt-4o
TCS_FAST_MODEL=azure/genailab-maas-gpt-4o-mini
TCS_VISION_MODEL=azure/genailab-maas-gpt-4o
TCS_EMBEDDING_MODEL=azure/genailab-maas-text-embedding-3-large

# Other models available on the same endpoint, for reference:
#   azure_ai/genailab-maas-DeepSeek-R1                     deep reasoning, slow
#   azure_ai/genailab-maas-DeepSeek-V3-0324                strong open-weight alt
#   azure_ai/genailab-maas-Llama-3.3-70B-Instruct          conversational
#   azure_ai/genailab-maas-Llama-4-Maverick-17B-128E...    fast MoE
#   azure_ai/genailab-maas-Phi-4-reasoning                 small reasoner
#   azure/genailab-maas-whisper                            speech to text

# TLS: the official TCS sample uses httpx.Client(verify=False), which disables
# certificate verification for EVERY outbound call in the process -- including
# the public APIs we cite as evidence. Try truststore first (it is on by
# default and uses the OS trust store). Only if that fails, scope the exemption
# to this one host:
#   FORGE_TLS_INSECURE_HOSTS=genailab.tcs.in
FORGE_TLS_INSECURE_HOSTS=

# Anthropic (second in chain)
ANTHROPIC_API_KEY=
ANTHROPIC_REASONING_MODEL=claude-opus-5
ANTHROPIC_FAST_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_VISION_MODEL=claude-opus-5

# Ollama (third in chain -- fully offline, zero cost, zero network).
# Defaults are the models actually present on the build machine as of
# 2026-08-07. NOTE: none of them is vision-capable, so the boot probe reports
# supports_vision=false and the vision tier resolves to structured_cv_descriptor.
# That is the designed path (ADR-0003), not a degradation.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_REASONING_MODEL=devstral:latest
OLLAMA_FAST_MODEL=llama-3.2-3b-it:latest
OLLAMA_VISION_MODEL=

# ---------------------------------------------------------------------------
# Persistence (PROFILE=docker only; PROFILE=local ignores these)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://forge:forge@localhost:5432/forge
REDIS_URL=redis://localhost:6379/0
CHROMA_HOST=localhost
CHROMA_PORT=8001
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=forge
MINIO_SECRET_KEY=
CACHE_BACKEND=memory

# ---------------------------------------------------------------------------
# MES. simulator | recorded | erpnext
# ---------------------------------------------------------------------------
MES_ADAPTER=simulator
ERPNEXT_BASE_URL=http://localhost:8080
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=

# ---------------------------------------------------------------------------
# Live external APIs. All four are keyless -- these are overrides only.
# Verified reachable 2026-08-07; see tests/integration/test_live_apis.py.
# ---------------------------------------------------------------------------
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
NHTSA_RECALLS_URL=https://api.nhtsa.gov/recalls/recallsByVehicle
FX_URL=https://open.er-api.com/v6/latest
NAGER_DATE_URL=https://date.nager.at/api/v3

# Plant location -- drives the live ambient temperature and humidity that feed
# the thread-surface-condition term in the causal model.
PLANT_LATITUDE=18.5204
PLANT_LONGITUDE=73.8567
PLANT_TIMEZONE=Asia/Kolkata
# Nager.Date has NO data for IN (returns HTTP 204). The calendar port degrades
# visibly rather than silently; these are the markets it can actually serve.
PLANT_HOLIDAY_MARKETS=DE,US

# ---------------------------------------------------------------------------
# Slack. Leave blank to run notify-only in console mode.
# ---------------------------------------------------------------------------
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_ALERT_CHANNEL=#forge-quality
SLACK_PUBLIC_CALLBACK_URL=
